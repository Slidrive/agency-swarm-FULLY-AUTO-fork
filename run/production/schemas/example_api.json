{
  "openapi": "3.0.0",
  "info": {
    "title": "Example Partner API",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "summary": "List items",
        "operationId": "listItems",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object", "properties": { "id": {"type": "string"}, "name": {"type": "string"} }, "required": ["id", "name"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
